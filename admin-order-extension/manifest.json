{
  "manifest_version": 3,
  "name": "윙발주 → 업체 어드민",
  "version": "0.1.0",
  "description": "윙발주에서 보낸 업체 양식 발주서를 업체 어드민(adminplus) 대량 주문입력(엑셀)에 올립니다.",
  "permissions": ["storage", "downloads"],
  "host_permissions": [
    "*://*.adminplus.co.kr/*",
    "https://firestore.googleapis.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://*.adminplus.co.kr/partner-app/*"],
      "js": ["admin.js"],
      "run_at": "document_idle"
    }
  ]
}
