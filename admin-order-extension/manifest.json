{
  "manifest_version": 3,
  "name": "윙발주 → 업체 어드민",
  "version": "0.4.0",
  "description": "윙발주에서 보낸 업체 양식 발주서를 업체 어드민(adminplus) 대량 주문입력(엑셀)에 올립니다. 어드민·오더플로 상품 화면에서 고른 옵션을 견적 시트용으로 복사합니다.",
  "permissions": [
    "storage",
    "downloads",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "*://*.adminplus.co.kr/*",
    "https://app.orderflow.kr/*",
    "https://firestore.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.adminplus.co.kr/partner-app/*",
        "https://app.orderflow.kr/*"
      ],
      "js": [
        "admin.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.adminplus.co.kr/partner-app/*"
      ],
      "js": [
        "auto-reload-page.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
