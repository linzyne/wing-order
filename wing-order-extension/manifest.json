{
  "manifest_version": 3,
  "name": "윙 주문서 → 윙발주",
  "version": "0.3.1",
  "description": "쿠팡 윙 주문배송관리에서 주문서 엑셀을 받아 윙발주로 바로 보냅니다. 사업자명은 크롬 프로필마다 따로 저장합니다.",
  "permissions": ["storage", "downloads"],
  "host_permissions": [
    "*://*.coupang.com/*",
    "*://*.coupangcdn.com/*",
    "*://*.amazonaws.com/*",
    "https://firestore.googleapis.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://wing.coupang.com/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://wing.coupang.com/*"],
      "js": ["wing.js"],
      "run_at": "document_idle"
    }
  ]
}
