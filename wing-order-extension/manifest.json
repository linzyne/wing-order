{
  "manifest_version": 3,
  "name": "윙 주문서 → 윙발주",
  "version": "0.9.4",
  "description": "쿠팡 윙 주문배송관리에서 주문서 엑셀을 받아 윙발주로 바로 보내고, 윙발주의 송장을 엑셀 대량배송으로 올립니다. 윙발주가 고른 주문을 롯데택배(ALPS)에 예약하고 운송장번호를 받아 옵니다. 광고센터에서 어제 광고비를 읽어 순마진에 씁니다. 사업자명은 크롬 프로필마다 따로 저장합니다.",
  "permissions": [
    "storage",
    "downloads",
    "alarms",
    "tabs",
    "offscreen",
    "contentSettings"
  ],
  "host_permissions": [
    "*://*.coupang.com/*",
    "*://*.coupangcdn.com/*",
    "*://*.amazonaws.com/*",
    "https://firestore.googleapis.com/*",
    "*://*.llogis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://wing.coupang.com/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://wing.coupang.com/*"
      ],
      "js": [
        "wing.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://advertising.coupang.com/*"
      ],
      "js": [
        "ads.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.llogis.com/*"
      ],
      "js": [
        "lotte.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "*://*.llogis.com/*"
      ],
      "js": [
        "lotte-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "options.html",
    "default_title": "롯데택배 자동 로그인 설정"
  }
}
